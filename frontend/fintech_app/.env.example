# Vite expõe apenas variáveis prefixadas com VITE_* ao bundle do navegador.
# IMPORTANTE: tudo nesse arquivo VIRA PÚBLICO no JS final. Nunca coloque
# segredos aqui — apenas configuração de ambiente.
#
# Copie este arquivo para `.env.local` (gitignorado) e ajuste para o seu setup.

# URL base do backend Spring Boot. Em dev costuma vir do proxy do Vite.
VITE_API_URL=/api
