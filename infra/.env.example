# ==============================================================================
#  FinTech App — variáveis da stack Docker local
#
#  COMO USAR:
#      cd infra
#      cp .env.example .env
#      # abra .env e preencha tudo que está marcado como  <<< PREENCHER >>>
#
#  O arquivo .env é lido automaticamente pelo `docker compose` e está coberto
#  pela regra `.env` do .gitignore da raiz — ou seja, NUNCA vai para o Git.
#  Este .env.example, sim, é versionado: mantenha-o só com valores de exemplo.
# ==============================================================================


# ─── 1. BANCO DE DADOS ────────────────────────────────────────────────────────
# Usado por três lugares ao mesmo tempo:
#   - container postgres  (cria o usuário/senha no primeiro boot)
#   - container backend   (DB_USERNAME / DB_PASSWORD → application-dev.yaml)
#   - você, ao conectar com DBeaver/pgAdmin em localhost:5432
#
# Se você MUDAR isto depois do primeiro `up`, o postgres NÃO recria o usuário.
# Nesse caso: docker compose down -v (apaga o volume) e suba de novo.
POSTGRES_USER=fintech
POSTGRES_PASSWORD=troque_esta_senha           # <<< PREENCHER >>>


# ─── 2. SEGREDOS COMPARTILHADOS BACKEND ↔ N8N ─────────────────────────────────
# Estes dois valores precisam ser IDÊNTICOS nos dois lados. O compose já injeta
# a mesma variável nos dois containers, então basta preencher uma vez aqui.
#
# INTERNAL_API_KEY
#   Chave simétrica no header X-Internal-Api-Key. Autentica:
#     backend → n8n   (POST /webhook/extratos/processar)
#     n8n → backend   (PATCH /extratos/{id}/status, POST /extratos/{id}/callback)
#   Comparada em tempo constante em AutenticacaoCallbackN8n.java.
#
# N8N_CALLBACK_SECRET
#   Segredo do HMAC-SHA256 do corpo bruto do callback (header X-N8N-Signature).
#
#   ⚠️ ATENÇÃO — pendência conhecida nos workflows:
#   os nós "Assinar payload sucesso" e "Assinar payload erro" (n8n-nodes-base.crypto)
#   estão com o campo `secret` VAZIO. Enquanto estiver assim, deixe
#   N8N_CALLBACK_SECRET também vazio, senão a assinatura não confere e o callback
#   é rejeitado. Para ativar de verdade, edite os dois nós na UI do n8n e ponha
#   no campo Secret:   {{ $('Config').first().json.callbackSecret }}
#
# Gerar valores fortes (PowerShell):
#   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
INTERNAL_API_KEY=                              # <<< PREENCHER >>>
N8N_CALLBACK_SECRET=                           # deixe vazio até corrigir o nó crypto


# ─── 3. CHAVE DA ANTHROPIC (Claude) ───────────────────────────────────────────
# É o único custo real do pipeline: o nó "Claude - Extrair e Classificar" chama
# https://api.anthropic.com/v1/messages para ler o PDF e classificar lançamentos.
# Pegue em: https://console.anthropic.com/settings/keys   (formato sk-ant-...)
#
# DOIS CAMINHOS — escolha um:
#
#   (a) RECOMENDADO — credencial na UI do n8n:
#       http://localhost:5678 → Credentials → New → "Anthropic API" → cole a chave.
#       O nó já referencia essa credencial pelo nome "Anthropic account".
#       Fica criptografada no banco do n8n com N8N_ENCRYPTION_KEY.
#       Nesse caso deixe a variável abaixo VAZIA.
#
#   (b) Via env: preencha abaixo e, na credencial do n8n, use a expressão
#       {{ $env.ANTHROPIC_API_KEY }} no campo da chave.
#       Mais prático para recriar o ambiente do zero; menos protegido.
ANTHROPIC_API_KEY=                             # opcional (veja (a) vs (b) acima)

# Modelo usado pelo workflow. Lido pelo nó ⚙️ Config como $env.CLAUDE_MODEL.
CLAUDE_MODEL=claude-sonnet-5


# ─── 4. CHAVE DE CRIPTOGRAFIA DO N8N ──────────────────────────────────────────
# Criptografa TODAS as credenciais salvas no n8n (Anthropic, Telegram, Evolution).
# Se este valor mudar, as credenciais existentes viram ilegíveis e você precisa
# recadastrar uma a uma. Gere UMA vez e nunca mais mexa.
#
#   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
N8N_ENCRYPTION_KEY=                            # <<< PREENCHER >>>


# ─── 5. CANAIS TELEGRAM / WHATSAPP (opcional) ─────────────────────────────────
# Os workflows 03 (Telegram) e 04 (WhatsApp) precisam de uma URL PÚBLICA para
# receber webhooks — localhost não é alcançável pelo Telegram nem pela Evolution.
# Enquanto você só usar o fluxo do app (workflow 02), pode ignorar esta seção.
#
# Para expor: Cloudflare Tunnel (gratuito) apontando para localhost:5678, e então
# coloque a URL resultante aqui. O n8n usa isso para registrar o webhook.
# N8N_WEBHOOK_PUBLIC_URL=https://algo.trycloudflare.com/
#
# O token do bot do Telegram e a chave da Evolution API são CREDENCIAIS da UI do
# n8n (Credentials → Telegram API / Header Auth), não variáveis daqui.


# ─── 6. AJUSTES DE PORTA E PERFIL (mexer só se der conflito) ──────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8082
N8N_PORT=5678
POSTGRES_PORT=5432

# dev | hml | prd — escolhe qual application-{perfil}.yaml e qual database usar.
SPRING_PROFILE=dev

# true  = PDF vai para o n8n e volta pelo callback
# false = tudo cai no parser local síncrono do backend (útil para testar sem IA)
N8N_ENABLED=true
N8N_TIMEOUT_MS=10000

TZ=America/Sao_Paulo
