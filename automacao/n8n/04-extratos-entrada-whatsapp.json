        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Webhook · WhatsApp').first().json.body.data.key.remoteJid.split('@')[0], text: 'Não encontrei uma conta vinculada a este número. Abra o app em Perfil → Integrações, vincule seu WhatsApp e aceite o consentimento de comunicação.' }) }}"
      }
    },
    {
      "id": "http-57",
      "name": "WhatsApp · falha no upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        460
      ],
      "parameters": {
        "options": {
          "timeout": 15000
        },
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
