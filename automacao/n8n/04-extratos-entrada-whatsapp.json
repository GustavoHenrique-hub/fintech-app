        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Montar contexto').first().json.numero, text: $json.mensagemUsuario }) }}"
      }
    },
    {
      "id": "http-56",
      "name": "WhatsApp · conta não vinculada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
